<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NewAgeWorship.Desktop</RootNamespace>
    <AssemblyName>NewAgeWorship</AssemblyName>
    <ApplicationIcon>Assets\NewAgeWorship.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\NewAgeWorship.Core\NewAgeWorship.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets\NewAgeWorship.ico" /></ItemGroup>
  <ItemGroup>
    <Content Include="Data\Bible_Versions.zip"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Models\vosk-model-small-en-us-0.15\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="AI\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Models\whisper\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
